<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_social_share"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/social_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:id="@+id/social_scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SEÇÃO 1: PERÍODO E CONTEÚDO (INÍCIO DA PÁGINA) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/social_share_section_period"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <!-- Chips de Período -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/social_chip_group_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_period_week"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_period_week" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_period_month"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_period_month" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_period_year"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_period_year" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_period_custom"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_period_custom" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Tipo de Mídia & Biblioteca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/social_chip_group_media"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_media_all"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_media_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_media_manga"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_media_manga" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_media_book"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_media_book" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <!-- Bibliotecas (Filtradas pelo Tipo de Mídia selecionado) -->
            <HorizontalScrollView
                android:id="@+id/social_scroll_libraries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/social_chip_group_libraries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_library_all"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_all_libraries" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/social_switch_only_completed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/social_share_only_completed" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- SEÇÃO 2: FORMATO E ESTILO VISUAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/social_share_section_style"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <!-- Proporções de Rede Social -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/social_chip_group_aspect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_aspect_4_5"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_aspect_4_5" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_aspect_9_16"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_aspect_9_16" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_aspect_1_1"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_aspect_1_1" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_aspect_16_9"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_aspect_16_9" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_aspect_2_3"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_aspect_2_3" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_aspect_single_full"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_aspect_single_full" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Templates de Layout -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/social_chip_group_template"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_template_bento"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_template_bento" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_template_shelf"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_template_shelf" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_template_wrapped"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_template_wrapped" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_template_list"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_template_list" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_template_magazine"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_template_magazine" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_template_polaroid"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_template_polaroid" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_template_podium"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_template_podium" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_template_glass"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_template_glass" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Temas de Cores -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/social_chip_group_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_dynamic"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_theme_dynamic" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_cover_blur"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_cover_blur" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_app"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_app" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_dark_slate"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_dark_slate" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_oled"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_oled" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_aurora"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_aurora" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_sunset"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_sunset" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_royal_gold"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_royal_gold" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_matcha"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_matcha" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_manga_pop"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_manga_pop" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_warm_paper"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_warm_paper" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_sakura"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_sakura" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_nordic"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_nordic" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_theme_custom"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_theme_custom" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Painel Expansível de Cores Personalizadas (Aparece quando CUSTOM é selecionado) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/social_custom_theme_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_custom_theme_title"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/social_btn_color_primary"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:textSize="11sp"
                            android:text="@string/social_share_custom_color_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/social_btn_color_secondary"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:textSize="11sp"
                            android:text="@string/social_share_custom_color_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/social_btn_color_accent"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:textSize="11sp"
                            android:text="@string/social_share_custom_color_accent" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/social_share_custom_text_mode"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/social_chip_group_text_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/social_chip_text_auto"
                            style="@style/Widget.Social.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/social_share_text_mode_auto" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/social_chip_text_light"
                            style="@style/Widget.Social.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/social_share_text_mode_light" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/social_chip_text_dark"
                            style="@style/Widget.Social.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/social_share_text_mode_dark" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Padrões de Fundo Decorativos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/social_share_section_pattern"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/social_chip_group_pattern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_pattern_none"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_pattern_none" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_pattern_grid"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_pattern_grid" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_pattern_dots"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_pattern_dots" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_pattern_orbs"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_share_pattern_orbs" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- SEÇÃO 3: TEXTOS E CURADORIA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/social_share_section_customization"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <!-- Campos de Texto -->
            <!-- Linha 1: Título -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/social_share_title_hint"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/social_input_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Linha 2: Subtítulo -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/social_share_subtitle_hint"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/social_input_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Linha 3: Capas por página (com botões +/-) e @handle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/social_input_layout_covers_per_page"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="@string/social_share_covers_per_page_hint"
                    app:boxBackgroundMode="outline"
                    app:startIconDrawable="@drawable/ic_remove"
                    app:startIconContentDescription="Diminuir capas por página"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_add"
                    app:endIconContentDescription="Aumentar capas por página">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/social_input_covers_per_page"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:singleLine="true"
                        android:text="9" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="@string/social_share_handle_hint"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/social_input_handle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Toggles de Métricas -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/social_chip_group_metrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_metric_time"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_show_time" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_metric_pages"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_show_pages" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_metric_titles"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_show_titles" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/social_chip_metric_progress"
                        style="@style/Widget.Social.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/social_share_show_progress" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/social_checkbox_card_blur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/social_share_card_blur_text" />

            <!-- CURADORIA MANUAL (RECOLHÍVEL COM ROLAGEM HORIZONTAL) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/social_curation_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/social_curation_title_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold"
                            tools:text="Obras selecionadas (8 de 8)" />

                        <ImageView
                            android:id="@+id/social_curation_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/social_curation_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/social_btn_select_all"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/social_share_curation_select_all"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/social_btn_deselect_all"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/social_share_curation_deselect_all"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/social_curation_recycler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- SEÇÃO 4: PREVIEW GRANDE (FINAL DA PÁGINA) -->
            <TextView
                android:id="@+id/social_preview_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/social_share_section_preview"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/social_preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="160dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/social_preview_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:id="@+id/social_preview_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="24dp"
                    android:text="@string/social_share_empty"
                    android:textAlignment="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

            </FrameLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/social_preview_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="@android:color/transparent"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp" />

            <!-- BOTÕES DE AÇÃO (LOGO ABAIXO DO PREVIEW GRANDE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/social_btn_save"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/social_share_btn_save"
                    app:icon="@drawable/ico_save_share_image" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/social_btn_share"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/social_share_btn_share"
                    app:icon="@drawable/ico_shared" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- App Bar posicionado por cima do Scroll com BlurView -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/social_appbar"
        style="@style/AppBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false"
        android:theme="@style/MainToolbarContentTheme.NoElevation"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/social_blur_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/social_toolbar"
                style="@style/MainToolbarThemeWithShadow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_navigator_header_size"
                android:background="@android:color/transparent"
                android:gravity="start|center"
                app:popupTheme="@style/MainToolbarStyle"
                app:title="@string/social_share_title" />

        </eightbitlab.com.blurview.BlurView>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
