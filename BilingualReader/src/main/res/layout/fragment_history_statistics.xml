<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame_history_statistics"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:clipChildren="false"
    tools:context=".view.ui.statistics.HistoryStatisticsFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/history_statistics_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <include layout="@layout/skeleton_shimmer_layout"/>
        
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_statistics_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:layout_margin="@dimen/margin_small"
                android:layout_centerHorizontal="true"
                android:layoutAnimation="@anim/layout_animation_history"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/history_padding"
                android:visibility="gone"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content_toolbar_history_statistics"/>

            <com.google.android.material.appbar.AppBarLayout
                style="@style/AppBarLayout"
                android:id="@+id/content_toolbar_history_statistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fitsSystemWindows="false"
                android:theme="@style/MainToolbarContentTheme"
                android:background="@android:color/transparent"
                android:layout_marginStart="@dimen/reader_title_margin_negative"
                android:layout_marginEnd="@dimen/reader_title_margin_negative"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/history_statistics_blur_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.appbar.MaterialToolbar
                        android:id="@+id/toolbar_history_statistics"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/default_navigator_header_size"
                        android:background="@android:color/transparent"
                        android:gravity="start|center"
                        android:paddingStart="@dimen/reader_title_margin_positive"
                        android:paddingEnd="@dimen/reader_title_margin_positive"
                        app:popupTheme="@style/MainToolbarStyle"
                        style="@style/MainToolbarThemeWithShadow"/>

                </eightbitlab.com.blurview.BlurView>

            </com.google.android.material.appbar.AppBarLayout>
        
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/history_statistics_scroll_up"
                style="@style/FloatingActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center"
                android:layout_margin="@dimen/history_scrolling_button_margin"
                android:contentDescription="@string/action_scroll_up"
                android:src="@drawable/ico_animated_scroll_up"
                android:visibility="gone"
                app:borderWidth="@dimen/history_up_border"
                app:fabCustomSize="@dimen/history_up_width"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/history_statistics_list"
                app:maxImageSize="@dimen/history_up_image_width" />
        
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/history_statistics_scroll_down"
                style="@style/FloatingActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:layout_margin="@dimen/history_scrolling_button_margin"
                android:contentDescription="@string/action_scroll_down"
                android:src="@drawable/ico_animated_scroll_down"
                android:visibility="gone"
                app:borderWidth="@dimen/history_down_border"
                app:fabCustomSize="@dimen/history_down_width"
                app:layout_constraintBottom_toBottomOf="@+id/history_statistics_list"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:maxImageSize="@dimen/history_down_image_width" />
            
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/history_statistics_popup_menu"
            style="@style/AppBackground.PopupBottom"
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="1dp"
            android:layout_gravity="center_horizontal"
            android:maxWidth="600dp"
            android:visibility="gone"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/history_statistics_popup_header_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/popup_background_size"
                android:layout_gravity="top" />

            <ImageView
                android:id="@+id/history_statistics_popup_menu_order_filter_touch"
                style="@style/TextTitle.Popup"
                android:layout_width="@dimen/popup_button_center"
                android:layout_height="wrap_content"
                android:layout_gravity="center|top"
                android:paddingTop="@dimen/popup_button_padding_vertical"
                android:paddingBottom="@dimen/popup_button_padding_vertical"
                android:paddingStart="@dimen/popup_button_padding_horizontal"
                android:paddingEnd="@dimen/popup_button_padding_horizontal"
                android:layout_marginTop="@dimen/popup_button_margin"
                android:contentDescription="@string/popup_reading_manga_open"
                android:scaleType="centerCrop"
                android:src="@drawable/ico_line_popup"/>

            <LinearLayout
                android:id="@+id/history_statistics_popup_content_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/popup_background_size"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/history_statistics_popup_tab"
                    style="@style/PopupTab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabGravity="fill"
                    app:tabMode="fixed"
                    app:tabPaddingBottom="0dp"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingStart="0dp"
                    app:tabPaddingTop="0dp">

                    <com.google.android.material.tabs.TabItem
                        android:id="@+id/history_statistics_tab_item_library"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_title_libraries" />

                    <com.google.android.material.tabs.TabItem
                        android:id="@+id/history_statistics_tab_item_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/statistics_chart_year" />

                </com.google.android.material.tabs.TabLayout>

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/history_statistics_popup_view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />
            </LinearLayout>
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
