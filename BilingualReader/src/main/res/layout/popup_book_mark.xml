<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame_popup_tts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/popup_book_mark_page"
            style="@style/TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            android:hint="@string/popup_book_mark_page"
            app:startIconDrawable="@drawable/ico_book_mark_page">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/popup_book_mark_page_edit"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/popup_book_mark_date"
            style="@style/TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            android:hint="@string/popup_book_mark_date"
            app:startIconDrawable="@drawable/ico_book_mark_date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/popup_book_mark_date_edit"
                android:clickable="true"
                android:editable="false"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/popup_book_mark_time"
            style="@style/TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            android:hint="@string/popup_book_mark_time"
            app:startIconDrawable="@drawable/ico_book_mark_time">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/popup_book_mark_time_edit"
                android:clickable="true"
                android:editable="false"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/popup_book_mark_reading_duration"
                style="@style/TextInputEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:layout_weight="1"
                android:hint="@string/popup_book_mark_reading_time"
                app:startIconDrawable="@drawable/ico_statistics_time">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/popup_book_mark_reading_duration_edit"
                    android:clickable="true"
                    android:editable="false"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/popup_book_mark_btn_auto_calc"
                style="@style/Button.IconOnly"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/margin_small"
                app:icon="@drawable/ico_refresh" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>