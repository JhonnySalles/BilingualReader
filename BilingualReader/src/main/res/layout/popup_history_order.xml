<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppBackground.Accent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/margin_small"
        android:paddingTop="@dimen/margin"
        android:paddingBottom="@dimen/margin_bottom">
        <br.com.fenix.bilingualreader.view.components.TriStateCheckBox
            android:id="@+id/popup_history_order_name"
            style="@style/OrderCheckBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/popup_library_manga_order_name"/>

        <br.com.fenix.bilingualreader.view.components.TriStateCheckBox
            android:id="@+id/popup_history_order_access"
            style="@style/OrderCheckBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/popup_library_manga_order_access"/>

        <br.com.fenix.bilingualreader.view.components.TriStateCheckBox
            android:id="@+id/popup_history_order_favorite"
            style="@style/OrderCheckBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/popup_library_manga_order_favorite"/>

        <br.com.fenix.bilingualreader.view.components.TriStateCheckBox
            android:id="@+id/popup_history_order_series"
            style="@style/OrderCheckBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/popup_library_manga_order_series"/>

        <br.com.fenix.bilingualreader.view.components.TriStateCheckBox
            android:id="@+id/popup_history_order_author"
            style="@style/OrderCheckBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/popup_library_manga_order_author"/>

        <br.com.fenix.bilingualreader.view.components.TriStateCheckBox
            android:id="@+id/popup_history_order_genre"
            style="@style/OrderCheckBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/popup_library_manga_order_genre"/>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
