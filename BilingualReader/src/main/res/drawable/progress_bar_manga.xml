<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="@color/card_manga_progress_background" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="4dp" />
                <gradient
                    android:startColor="@color/card_manga_indigo_base"
                    android:endColor="@color/card_manga_indigo_light"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
