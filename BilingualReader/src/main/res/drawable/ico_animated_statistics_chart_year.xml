<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="calendar_group"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="calendar_path"
                    android:fillColor="?attr/colorOnSecondary"
                    android:pathData="M 17 2 C 16.45 2 16 2.45 16 3 L 16 4 L 8 4 L 8 3 C 8 2.45 7.55 2 7 2 S 6 2.45 6 3 L 6 4 L 5 4 C 3.89 4 3.01 4.9 3.01 6 L 3 20 C 3 21.1 3.89 22 5 22 L 19 22 C 20.1 22 21 21.1 21 20 L 21 6 C 21 4.9 20.1 4 19 4 L 18 4 L 18 3 C 18 2.45 17.55 2 17 2 Z M 19 20 L 5 20 L 5 10 L 19 10 L 19 20 Z M 11 13 C 11 12.45 11.45 12 12 12 S 13 12.45 13 13 S 12.55 14 12 14 S 11 13.55 11 13 Z M 7 13 C 7 12.45 7.45 12 8 12 S 9 12.45 9 13 S 8.55 14 8 14 S 7 13.55 7 13 Z M 15 13 C 15 12.45 15.45 12 16 12 S 17 12.45 17 13 S 16.55 14 16 14 S 15 13.55 15 13 Z M 11 17 C 11 16.45 11.45 16 12 16 S 13 16.45 13 17 S 12.55 18 12 18 S 11 17.55 11 17 Z M 7 17 C 7 16.45 7.45 16 8 16 S 9 16.45 9 17 S 8.55 18 8 18 S 7 17.55 7 17 Z M 15 17 C 15 16.45 15.45 16 16 16 S 17 16.45 17 17 S 16.55 18 16 18 S 15 17.55 15 17 Z"/>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="calendar_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="150"
                    android:valueFrom="1"
                    android:valueTo="0.8"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="150"
                    android:valueFrom="1"
                    android:valueTo="0.8"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="rotation"
                    android:duration="150"
                    android:valueFrom="0"
                    android:valueTo="-15"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:startOffset="150"
                    android:duration="200"
                    android:valueFrom="0.8"
                    android:valueTo="1.15"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:startOffset="150"
                    android:duration="200"
                    android:valueFrom="0.8"
                    android:valueTo="1.15"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="rotation"
                    android:startOffset="150"
                    android:duration="200"
                    android:valueFrom="-15"
                    android:valueTo="10"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:startOffset="350"
                    android:duration="150"
                    android:valueFrom="1.15"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:startOffset="350"
                    android:duration="150"
                    android:valueFrom="1.15"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="rotation"
                    android:startOffset="350"
                    android:duration="150"
                    android:valueFrom="10"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
